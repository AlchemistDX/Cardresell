{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "signin.html", "use": "@vercel/static" },
    { "src": "terms.html", "use": "@vercel/static" },
    { "src": "privacy.html", "use": "@vercel/static" },
    { "src": "about.html", "use": "@vercel/static" },
    { "src": "contact.html", "use": "@vercel/static" },
    { "src": "accuracy.html", "use": "@vercel/static" },
    { "src": "pricing.html", "use": "@vercel/static" },
    { "src": "manifest.json", "use": "@vercel/static" },
    { "src": "card-index.json", "use": "@vercel/static" },
    { "src": "mtg-index.json", "use": "@vercel/static" },
    { "src": "robots.txt", "use": "@vercel/static" },
    { "src": "sitemap.xml", "use": "@vercel/static" },
    { "src": "public/photo-tips/*.webp", "use": "@vercel/static" },
    { "src": "public/*.png", "use": "@vercel/static" },
    { "src": "public/favicon.ico", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/(.*)", "continue": true, "headers": { "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload", "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin", "X-Frame-Options": "SAMEORIGIN", "Permissions-Policy": "camera=(self), microphone=(), geolocation=()" } },
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/grade/([A-Za-z0-9_-]+)", "dest": "/api/grade-share.js?id=$1" },
    { "src": "/card-index.json", "dest": "/card-index.json", "headers": { "Cache-Control": "public, max-age=86400, immutable" } },
    { "src": "/mtg-index.json", "dest": "/mtg-index.json", "headers": { "Cache-Control": "public, max-age=86400, immutable" } },
    { "src": "/signin", "dest": "/signin.html" },
    { "src": "/terms", "dest": "/terms.html" },
    { "src": "/privacy", "dest": "/privacy.html" },
    { "src": "/about", "dest": "/about.html" },
    { "src": "/contact", "dest": "/contact.html" },
    { "src": "/accuracy", "dest": "/accuracy.html" },
    { "src": "/pricing", "dest": "/pricing.html" },
    { "src": "/manifest.json", "dest": "/manifest.json" },
    { "src": "/robots.txt", "dest": "/robots.txt", "headers": { "Content-Type": "text/plain; charset=utf-8", "Cache-Control": "public, max-age=3600" } },
    { "src": "/sitemap.xml", "dest": "/sitemap.xml", "headers": { "Content-Type": "application/xml; charset=utf-8", "Cache-Control": "public, max-age=3600" } },
    { "src": "/photo-tips/(.*\\.webp)", "dest": "/public/photo-tips/$1", "headers": { "Cache-Control": "public, max-age=604800, immutable", "Content-Type": "image/webp" } },
    { "src": "/photo-tips/?", "status": 308, "headers": { "Location": "/?photo_tips=1" } },
    { "src": "/og-image.png", "dest": "/public/og-image.png", "headers": { "Content-Type": "image/png", "Cache-Control": "public, max-age=86400" } },
    { "src": "/favicon.ico", "dest": "/public/favicon.ico", "headers": { "Content-Type": "image/x-icon", "Cache-Control": "public, max-age=604800, immutable" } },
    { "src": "/apple-touch-icon.png", "dest": "/public/apple-touch-icon.png", "headers": { "Content-Type": "image/png", "Cache-Control": "public, max-age=604800, immutable" } },
    { "src": "/icon-192.png", "dest": "/public/icon-192.png", "headers": { "Content-Type": "image/png", "Cache-Control": "public, max-age=604800, immutable" } },
    { "src": "/icon-512.png", "dest": "/public/icon-512.png", "headers": { "Content-Type": "image/png", "Cache-Control": "public, max-age=604800, immutable" } },
    { "src": "/_vercel/insights/(.*)", "continue": true },
    { "src": "/(.*\\.html)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" } }
  ]
}
